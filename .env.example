# ==========================================
# INTERNSHIP SCOUT CONFIGURATION (.env.example)
# ==========================================

# Database Path
DB_PATH=jobs.db

# Search Keywords (comma-separated)
SCRAPE_KEYWORDS=intern,internship,software intern,junior developer,trainee

# ------------------------------------------
# EMAIL NOTIFICATION SETTINGS (SMTP)
# ------------------------------------------
ENABLE_EMAIL_NOTIFICATION=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
NOTIFY_EMAIL=recipient_email@gmail.com

# ------------------------------------------
# WHATSAPP NOTIFICATION SETTINGS
# ------------------------------------------
ENABLE_WHATSAPP_NOTIFICATION=false

# Option A: Twilio WhatsApp API
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# Option B: CallMeBot WhatsApp API (Free alternative)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
